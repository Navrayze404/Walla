{
  "expo": {
    "name": "Walla",
    "scheme": "walla",
    "slug": "Walla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.walla.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B132B"
      }
    },

    "extra": {
      "eas": {
        "projectId": "37350d0f-685e-403b-9574-f6416e1f5da6"
      }
    },

    "owner": "navrayze404",

    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B132B"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ]
  }
}